# OpenAI conversation runtime. The app owns transport fallback, so SDK retries stay disabled.
OPENAI_API_KEY=
OPENAI_MEMORY_CHAT_TIMEOUT_SECONDS=25

# Canonical Sign in with Apple server authority
APPLE_SIGN_IN_CLIENT_ID=com.obernburg2025.RemembermeAI
APPLE_SIGN_IN_TEAM_ID=BJ74JQ9L82
APPLE_SIGN_IN_KEY_ID=
# PKCS#8 .p8 content; deployment environments may encode newlines as \\n.
APPLE_SIGN_IN_PRIVATE_KEY=
# URL-safe base64 encoding of exactly 32 cryptographically random bytes.
STAY_AUTH_DATA_ENCRYPTION_KEY=


# RememberMeAI Tavus LiveKit runtime
AVATAR_RUNTIME_ENABLE_TAVUS=false
AVATAR_RUNTIME_TAVUS_WORKER_NAME=rememberme-tavus-avatar
AVATAR_RUNTIME_TAVUS_CONNECT_TIMEOUT_SECONDS=45
AVATAR_RUNTIME_LIVEKIT_TOKEN_TTL_SECONDS=3600
AVATAR_RUNTIME_ROOM_EMPTY_TIMEOUT_SECONDS=300
AVATAR_RUNTIME_ROOM_DEPARTURE_TIMEOUT_SECONDS=60
TAVUS_API_KEY=
TAVUS_REPLICA_ID=
TAVUS_PERSONA_ID=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
